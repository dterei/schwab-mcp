# Copy to .env and fill in from your app at https://developer.schwab.com
# (Dashboard > Apps > your app). .env is git-ignored: never commit it.
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=

# Must match one of the app's callback URLs exactly. Default: https://127.0.0.1
#SCHWAB_CALLBACK_URL=https://127.0.0.1

# Where the saved login lives. Default: <your config dir>/schwabtx/token.json
# On Linux and macOS the file is always made readable only by you. On Windows
# it takes its folder's permissions, so keep it inside your user profile.
#SCHWAB_TOKEN_FILE=

# Where `schwabtx snapshot` appends its snapshots.
# Default: <your config dir>/schwabtx/snapshots.jsonl
# On Linux and macOS the file is kept readable only by you. On Windows it
# takes its folder's permissions, so keep it inside your user profile.
#SCHWAB_SNAPSHOT_FILE=

# The store, the SQLite file that schwabtx import, status, edit, export and
# store use. Default: <your config dir>/schwabtx/history.db, and on Windows
# %LocalAppData%\schwabtx\history.db. Keep it on a local disk, not in a
# synced folder. Its -wal and -shm beside it are part of it: copy it with
# schwabtx store backup, never by copying files.
#SCHWAB_STORE_FILE=

# The schwabtx that the scheduler scripts in cmd/schwabtx/schedule run.
# Default: the first on the scheduler's PATH, else ~/go/bin/schwabtx
# (%USERPROFILE%\go\bin\schwabtx.exe on Windows).
#SCHWABTX=
