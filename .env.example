# Copy to .env and fill in from your app at https://developer.schwab.com
# (Dashboard > Apps > your app). .env is git-ignored: never commit it.
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=

# Must match one of the app's callback URLs exactly. Default: https://127.0.0.1
#SCHWAB_CALLBACK_URL=https://127.0.0.1

# Where the saved login lives. Default: <your config dir>/schwabtx/token.json
# On Linux and macOS the file is always made readable only by you. On Windows
# it takes its folder's permissions, so keep it inside your user profile.
#SCHWAB_TOKEN_FILE=

# Where `schwabtx snapshot` appends its snapshots.
# Default: <your config dir>/schwabtx/snapshots.jsonl
#SCHWAB_SNAPSHOT_FILE=
