<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
The launchd agent that runs snapshot.sh every day at 9:05 p.m., or when the
Mac wakes if it was asleep then. launchd does not expand ~ or $HOME, so the
paths are absolute: install-agent.sh, next to this file, fills in yours.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.github.dterei.schwabtx.snapshot</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/sh</string>
		<string>/Users/YOU/schwab-mcp/cmd/schwabtx/schedule/snapshot.sh</string>
	</array>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>21</integer>
		<key>Minute</key>
		<integer>5</integer>
	</dict>
	<key>StandardOutPath</key>
	<string>/Users/YOU/Library/Logs/schwabtx-snapshot.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/YOU/Library/Logs/schwabtx-snapshot.log</string>
</dict>
</plist>
